u-- Tabela-pai
CREATE TABLE Restaurantes (
RestauranteID INT PRIMARY KEY,
Nome VARCHAR(100) NOT NULL,
Categoria VARCHAR(50) NOT NULL
);
-- Tabela-filha com FK a nível de tabela
CREATE TABLE Pedidos (
PedidoID INT PRIMARY KEY,
ValorTotal DECIMAL(10,2) NOT NULL,
RestauranteID INT,
FOREIGN KEY (RestauranteID)
REFERENCES Restaurantes(RestauranteID)
);
-- Caso a FK não tenha sido criada junto:
ALTER TABLE Pedidos
ADD CONSTRAINT FK_Pedidos_Rest
FOREIGN KEY (RestauranteID)
REFERENCES Restaurantes(RestauranteID);

